{
  "extends": "../../tsconfig.root.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "rootDir": "./src",
    "outDir": "./dist/types",
    "emitDeclarationOnly": true,
    "declarationMap": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.{ts,tsx}"]
}
