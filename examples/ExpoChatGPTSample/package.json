{
  "name": "expochatgptsample",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start -c --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "postinstall": "mkdir public; cp $(node -p \"require.resolve('canvaskit-wasm/bin/full/canvaskit.wasm', { paths: [require.resolve('@shopify/react-native-skia')] })\") public/canvaskit.wasm",
    "deploy": "npx expo export -p web && npx eas-cli@latest deploy"
  },
  "dependencies": {
    "@react-native-community/netinfo": "^11.4.1",
    "@react-navigation/drawer": "^7.7.5",
    "@shopify/react-native-skia": "2.2.12",
    "@stream-io/chat-react-native-ai": "workspace:^",
    "expo": "^54.0.1",
    "expo-clipboard": "~8.0.7",
    "expo-image-picker": "~17.0.8",
    "expo-linking": "^8.0.8",
    "expo-router": "~6.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.4",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "^2.29.0",
    "react-native-reanimated": "^4.1.3",
    "react-native-safe-area-context": "^5.6.1",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.15.0",
    "react-native-teleport": "^1.1.4",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.6.1",
    "stream-chat": "^9.42.1",
    "stream-chat-expo": "^9.1.0",
    "victory-native": "^41.20.2"
  },
  "devDependencies": {
    "@babel/plugin-proposal-export-namespace-from": "^7.18.9",
    "@babel/core": "^7.29.6",
    "@rnx-kit/metro-config": "^2.1.0",
    "@rnx-kit/metro-resolver-symlinks": "^0.2.5",
    "typescript": "~5.9.2"
  },
  "version": "1.0.1",
  "private": true
